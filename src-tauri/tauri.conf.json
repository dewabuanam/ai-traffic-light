{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Traffic Lights",
  "version": "1.1.0",
  "identifier": "com.quartexsoftware.ai-traffic-lights",
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": "node scripts/build-sidecar.js",
    "beforeDevCommand": "node scripts/build-sidecar.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Claude Traffic Light",
        "width": 103,
        "height": 264,
        "minWidth": 56,
        "minHeight": 56,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "center": false,
        "x": 40,
        "y": 40,
        "maximizable": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Claude Code status traffic light",
    "longDescription": "An always-on-top, resizable traffic light that shows Claude Code CLI status: red = needs your response, yellow = in progress, green = task finished.",
    "externalBin": [
      "binaries/claude-light-hook"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
